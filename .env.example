# Rune environment configuration template
#
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#
# The real ".env" file is never committed to version control.
# ---------------------------------------------------------------------------


# REQUIRED in every environment. The key used to sign sign-in sessions.
#
# Without it, signing in fails. In production it must be at least 32 random
# characters and not a well-known value, or Rune refuses to start.
#
# Generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Keep it stable. Changing it signs everyone out.
JWT_SECRET=


# RECOMMENDED. The public address Rune is served from, e.g.
#     RUNE_BASE_URL=https://rune.example.com     (production)
#     RUNE_BASE_URL=http://localhost:3000        (your own computer)
# Used for password-reset links and post-login redirects, and to decide
# whether cookies are marked Secure. Unset, Rune uses the request's own host,
# which is fine on Vercel/Netlify/localhost but wrong behind a reverse proxy
# or in a container. Easiest: run `npm run setup`, which fills this in for you.
RUNE_BASE_URL=

# OPTIONAL. How many reverse proxies sit in front of Rune and append to
# X-Forwarded-For (default 1: one Caddy, nginx, Traefik or platform edge).
# Rate limiting uses the address the nearest trusted proxy recorded, so it
# can't be dodged by sending a fake header. Set 2 for e.g. a CDN in front
# of nginx. Rune should not be exposed to the internet without a proxy.
# RUNE_TRUSTED_PROXY_HOPS=1

# OPTIONAL. The port `next dev` / `next start` listen on (default 3000).
# PORT=3000


# Who may create an account (default: open). Email + password sign-up needs
# nothing else; this only controls who is allowed to use it.
#   open     anyone who can reach the site
#   domains  only addresses at RUNE_ALLOWED_EMAIL_DOMAINS
#   closed   nobody; an administrator creates accounts
RUNE_SIGNUP_MODE=
# Comma-separated, used with RUNE_SIGNUP_MODE=domains, e.g. lab.edu,company.com
RUNE_ALLOWED_EMAIL_DOMAINS=


# OPTIONAL. Outbound email for "Forgot your password?" reset links. Without
# it, a reset link is written to the server console for an administrator to
# relay - the feature still works, just not self-service. See
# docs/ADMINISTRATOR_GUIDE.md §1b.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=


# REQUIRED. PostgreSQL connection string. Rune runs entirely on Postgres
# through Prisma, with no file-based fallback.
#
# For local development, start a zero-install Postgres in a separate terminal:
#     npm run dev:db
# then use the URL it prints:
#     DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
#
# In production, point this at your managed Postgres.
DATABASE_URL=


# REQUIRED when using docker-compose.yml. The password for the bundled
# Postgres container. docker-compose.yml refuses to start without it (there is
# no default), and Postgres is only reachable from the app container over the
# internal compose network.
#     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Not used if you point DATABASE_URL at your own managed Postgres.
POSTGRES_PASSWORD=


# OPTIONAL. Comma-separated email addresses that get the admin console. An
# address listed here may register even when RUNE_SIGNUP_MODE=closed, which is
# how the first admin gets in on a host with no shell. Alternatively, create
# one with `npm run create-user -- --admin`, or set a user's `role` column to
# DEVELOPER in the database.
RUNE_ADMIN_EMAILS=


# OPTIONAL. Password for the built-in developer (admin) account,
# developer_adiga@rune.io, used only when that account is first created.
# In production the account is created ONLY if this is set to a strong
# password (10+ characters, not a common one); otherwise there is no
# built-in admin - use RUNE_ADMIN_EMAILS instead. In development it defaults
# to a public convenience password. See docs/ADMINISTRATOR_GUIDE.md §1c.
RUNE_DEVELOPER_PASSWORD=


# OPTIONAL. Model transformers.js downloads for local, on-device dictation
# (the Whisper fallback used when the browser has no built-in speech
# recognition). Defaults to Xenova/whisper-base.en. `npm run setup` can
# download it for you; see docs/ADMINISTRATOR_GUIDE.md §1d.
RUNE_WHISPER_MODEL=
RUNE_WHISPER_CACHE_DIR=


# OPTIONAL. Path to a Chrome or Chromium binary, used for notebook PDF
# export. Leave it unset to let Rune look in the usual locations.
PUPPETEER_EXECUTABLE_PATH=


# OPTIONAL. Folder for data Rune writes at runtime: uploaded files and the
# admin audit log. Defaults to ./data. In production, point this at a
# persistent disk or mounted volume so it survives a redeploy.
RUNE_DATA_DIR=

# OPTIONAL. Overrides just the uploads folder (defaults to <RUNE_DATA_DIR>/uploads).
RUNE_UPLOAD_DIR=


# OPTIONAL. S3-compatible object storage for uploads (AWS S3, Cloudflare R2,
# Backblaze B2, MinIO, and others). If these are set, uploads go to the bucket
# instead of local disk. Required on an ephemeral or serverless filesystem.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=


# OPTIONAL. Pusher credentials for real-time team chat. Without them, chat
# still works and refreshes every few seconds instead of instantly.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
